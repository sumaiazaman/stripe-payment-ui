    "react": ">=18",
    "react-dom": ">=18",
    "@stripe/stripe-js": ">=2",
    "@stripe/react-stripe-js": ">=2"
  },
  "devDependencies": {
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
