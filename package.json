{
  "name": "@sumaiazaman/stripe-payment",
  "version": "1.0.0",
  "description": "Stripe payment UI components for React and Next.js",
  "author": "Sumaia Zaman",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
