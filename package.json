{
  "name": "@sumaiaaktar/stripe-payment",
  "version": "1.0.0",
  "description": "Stripe payment UI components for React and Next.js",
  "author": "Sumaia Zaman",
  "license": "MIT",
  "homepage": "https://github.com/sumaiazaman/stripe-payment-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumaiazaman/stripe-payment-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sumaiazaman/stripe-payment-ui/issues"
  },
  "keywords": [
    "stripe",
    "payment",
    "react",
    "nextjs",
    "checkout",
    "stripe-elements",
    "payment-gateway"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@stripe/stripe-js": ">=2",
    "@stripe/react-stripe-js": ">=2"
  },
  "devDependencies": {
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
